<% provide :title do %>
  <%= t("admin.header.title") %> - <%= t("admin.menu.legislation") %> - <%= @process.title %> - <%= t("admin.legislation.homepage.edit.title") %>
<% end %>

<div class="legislation-admin legislation-process-edit">
  <%= back_link_to admin_legislation_processes_path, t("admin.legislation.processes.edit.back") %>

  <h2><%= @process.title %></h2>

  <%= render "admin/legislation/processes/subnav", process: @process, active: t('activerecord.models.site_customization/help_text.one') %>

  <%= sanitize(@help_text_content, tags: %w(p br strong em a ul ol li img), attributes: %w(href title height width src)) %>
</div>

