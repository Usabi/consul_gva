<h2 class="inline-block"><%= t("admin.polls.index.title") %></h2>

<%= link_to t("admin.active_polls.edit.title"),
            edit_admin_active_polls_path,
            class: "button hollow float-right" %>

<%= link_to t("admin.polls.index.create"),
            new_admin_poll_path,
            class: "button float-right" %>

<%= render "/admin/poll/polls/help_subnav", i18n_namespace: "admin.poll.polls.index", active: "polls" %>
<%= render "search_form" %>

<% if @polls.any? %>
  <table>
    <thead>
      <th class="text-center"><%= link_to_sorted_admin_resource "polls", :id %></th>
      <th class="small-3"><%= link_to_sorted_admin_resource "polls", :name %></th>
      <th class="text-center"><%= t("admin.polls.index.status") %></th>
      <th class="text-center" data-field="starts_at" ><%= link_to_sorted_admin_resource "polls", :starts_at %></th>
      <th class="text-center" data-field="ends_at" ><%= link_to_sorted_admin_resource "polls", :ends_at %></th>
      <% if feature?(:sdg) %>
        <th class="text-center"><%= SDG::Goal.model_name.human(count: :other).upcase_first %></th>
        <th class="text-center"><%= SDG::Target.model_name.human(count: :other).upcase_first %></th>
      <% end %>
      <th><%= t("admin.actions.actions") %></th>
    </thead>
    <tbody>
      <%= render @polls %>
    </tbody>
  </table>
<% else %>
  <div class="callout primary">
    <%= t("admin.polls.index.no_polls") %>
  </div>
<% end %>
