<h2 class="inline-block"><%= t("admin.citizen_newsletters.index.title") %></h2>

<table>
  <thead>
    <tr>
      <th><%= t("admin.citizen_newsletters.index.created_at") %></th>
      <th><%= t("admin.citizen_newsletters.index.status") %></th>
      <th><%= t("admin.citizen_newsletters.index.sent_at") %></th>
      <th><%= t("admin.citizen_newsletters.index.actions") %></th>
    </tr>
  </thead>
  <tbody>
    <% @citizen_newsletters.each do |newsletter| %>
      <tr>
        <td><%= l newsletter.created_at.to_datetime, format: :long %></td>
        <td>
          <span class="label <%= newsletter.status_class %>">
            <%= t("admin.citizen_newsletters.index.#{newsletter.status}") %>
          </span>
        </td>
        <td><%= l newsletter.sent_at.to_datetime, format: :long if newsletter.sent_at %></td>
        <td>
          <%= link_to t("admin.citizen_newsletters.index.view"),
                      admin_citizen_newsletter_path(newsletter),
                      class: "button hollow" %>
          <% if newsletter.pending? || newsletter.failed? %>
            <%= link_to t("admin.citizen_newsletters.index.resend"),
                        resend_admin_citizen_newsletter_path(newsletter),
                        method: :post,
                        class: "button hollow alert",
                        data: { confirm: t("admin.citizen_newsletters.index.confirm_resend") } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @citizen_newsletters %>
