<h2><%= t("admin.supporters.search.title") %></h2>

<%= render "admin/shared/user_search", url: search_admin_supporters_path %>

<div id="supporters">
  <% if @users.any? %>
    <h3><%= page_entries_info @users %></h3>
    <%= link_to t("admin.budget_investments.index.download_current_selection"),
              search_admin_supporters_path(csv_params),
              class: "float-right small clear" %>

    <table>
      <thead>
        <th scope="col"><%= Supporter.human_attribute_name(:name) %></th>
        <th scope="col"><%= Supporter.human_attribute_name(:email) %></th>
        <th scope="col"><%= t("admin.shared.actions") %></th>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td>
              <%= render Admin::Roles::TableActionsComponent.new(user.supporter ||user.build_supporter) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="callout alert margin">
      <%= t("admin.shared.no_search_results") %>
    </div>
  <% end %>
</div>
