<h2><%= t("admin.valuators.search.title") %></h2>

<%= render "admin/shared/user_search", url: search_admin_valuators_path %>

<div id="valuators">
  <% if @users.any? %>
    <h3><%= page_entries_info @users %></h3>
    <%= link_to t("admin.budget_investments.index.download_current_selection"),
              search_admin_valuators_path(csv_params),
              class: "float-right small clear" %>

    <%= render "valuators", valuators: @users %>
  <% else %>
    <div class="callout alert margin">
      <%= t("admin.shared.no_search_results") %>
    </div>
  <% end %>
</div>
