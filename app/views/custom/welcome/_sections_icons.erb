<div  class="sections-icon">

  <h2 class="title"><%= t("welcome.sections.title") %></h2>

  <div class="sections-icon__grid">
    <%= link_to debates_path, class: "sections-icon__item" do %>
      <div class="sections-icon__top">
        <div class="sections-icon__item__icon">
          <%= image_tag("icon-sections/ico-debatir.png", alt: "") %>
        </div>
        <div class="sections-icon__item__process-name">
          <%= t("welcome.sections.debate.process_name") %>
        </div>
      </div>
      <div class="sections-icon__item__title"><%= t("welcome.sections.debate.title") %></div>
      <div class="sections-icon__item__description"><%= t("welcome.sections.debate.description") %></div>
    <% end %>

