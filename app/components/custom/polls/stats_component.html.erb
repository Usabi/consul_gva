<div id="stats_polls">
  <div class="header-stats">
    <%= image_tag("icon-sections/ico-votar.png", alt: "") unless summary? %>
    <h2 class="<%= summary? ? 'sidebar-title' : '' %>"><%= t("stats.polls.title") %></h2>
  </div>

  <div class="<%= summary? ? 'summary-box' : '' %>">
    <div class="stats-section">
      <h4 class="stats-subtitle"><%= t("stats.polls.general") %></h4>
      <div class="stats-row">
        <div class="stats-item">
          <span class="stats-number"><%= @total_polls %></span>
          <span class="stats-label"><%= t("stats.polls.total") %></span>
        </div>

        <div class="stats-item">
          <span class="stats-number"><%= @polls_last_week %></span>
          <span class="stats-label"><%= t("stats.polls.last_week") %></span>
        </div>

        <div class="stats-item">
          <span class="stats-number"><%= @active_polls %></span>
          <span class="stats-label"><%= t("stats.polls.active") %></span>
        </div>

        <div class="stats-item">
          <span class="stats-number"><%= @expired_polls %></span>
          <span class="stats-label"><%= t("stats.polls.expired") %></span>
        </div>
      </div>

      <% unless summary? %>
        <div class="stats-section">
          <h4 class="stats-subtitle"><%= t("stats.polls.participation") %></h4>
          <div class="stats-row">
            <div class="stats-item">
              <span class="stats-number"><%= @total_votes %></span>
              <span class="stats-label"><%= t("stats.polls.total_votes") %></span>
            </div>

            <div class="stats-item">
              <span class="stats-number"><%= @votes_web %></span>
              <span class="stats-label"><%= t("stats.polls.web_votes") %></span>
            </div>

            <div class="stats-item">
              <span class="stats-number"><%= @votes_booth %></span>
              <span class="stats-label"><%= t("stats.polls.booth_votes") %></span>
            </div>
          </div>

          <div class="stats-row">
            <div class="stats-item number-with-info participants total-participants">
              <div class="content">
                <span class="stats-number number"><%= @total_participants %></span>
              </div>
              <span class="stats-label row"><%= t("stats.polls.participants") %></span>
            </div>
          </div>
        </div>

        <div id="participants_by_gender" class="stats-section stats-group">
          <h4 class="stats-subtitle"><%= t("stats.by_gender") %></h4>

          <div class="stats-item number-with-info participants male">
            <div class="content">
              <span class="stats-number number"><%= @total_male_participants %></span>
              <span class="stats-label info"><%= t("stats.men_percentage", percentage: helpers.number_to_stats_percentage(@male_percentage)) %></span>
            </div>
          </div>

          <div class="stats-item number-with-info participants female">
            <div class="content">
              <span class="stats-number number"><%= @total_female_participants %></span>
              <span class="stats-label info"><%= t("stats.women_percentage", percentage: helpers.number_to_stats_percentage(@female_percentage)) %></span>
            </div>
          </div>

          <div class="stats-item number-with-info participants other">
            <div class="content">
              <span class="stats-number number"><%= @total_other_participants %></span>
              <span class="stats-label info"><%= t("stats.other_percentage", percentage: helpers.number_to_stats_percentage(@other_percentage)) %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if summary? %>
      <div>
        <a href="<%= stats_path + "#stats_polls" %>" class="float-right"><%= t("stats.advanced") %></a>
      </div>
    <% end %>
  </div>
</div>
