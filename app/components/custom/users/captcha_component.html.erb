<% if ptt_enabled? %>
  <div data-captcha-id="<%= ptt_captcha_id %>"
       data-captcha-idioma="<%= ptt_idioma %>"
       data-captcha-posicio="centrat"></div>
  <%= hidden_field_tag :ptt_valor_captcha, "", id: "ptt_valor_captcha" %>
  <%= javascript_include_tag PttCaptchaApi.front_js_url %>
<% elsif google_enabled? %>
  <%= recaptcha_tags %>
<% end %>
